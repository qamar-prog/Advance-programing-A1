  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expected = Number(pm.request.headers.get(\"x-expected-status\"));",
          "pm.test(\"status matches expected\", () => pm.expect(pm.response.code).to.eql(expected));",
          "pm.test(\"response follows JSON or Problem Details contract\", () => {",
          "  if (expected === 204) {",
          "    pm.expect(pm.response.text()).to.eql(\"\");",
          "    return;",
          "  }",
          "  pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"json\");",
          "  const body = pm.response.json();",
          "  if (expected >= 400) {",
          "    pm.expect(body.status).to.eql(expected);",
          "    pm.expect(body.title).to.be.a(\"string\").and.not.empty;",
          "    if (expected === 400) pm.expect(body.errors).to.be.an(\"object\");",
          "  } else {",
          "    pm.expect(body).to.be.an(\"object\");",
          "    if (expected === 201) pm.expect(pm.response.headers.get(\"Location\")).to.be.a(\"string\").and.not.empty;",
          "  }",
          "});",
          "const url = pm.request.url.toString();",
          "if (url.includes(\"/api/auth/login\") && expected === 200) {",
          "  const login = JSON.parse(pm.request.body.raw);",
          "  const result = pm.response.json();",
          "  if (login.username === \"teacher\") pm.environment.set(\"token\", result.token);",
          "  if (login.username === \"student1\") {",
          "    pm.environment.set(\"studentToken\", result.token);",
          "    let part = result.token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\");",
          "    part += \"=\".repeat((4 - part.length % 4) % 4);",
          "    const payload = JSON.parse(atob(part));",
          "    pm.collectionVariables.set(\"ownStudentId\", payload.student_id);",
          "  }",
          "}",
          "if (url.endsWith(\"/api/students\") && pm.request.method === \"GET\" && expected === 200) {",
          "  const items = pm.response.json().items || [];",
          "  const ownId = Number(pm.collectionVariables.get(\"ownStudentId\"));",
          "  const other = items.find(item => item.id !== ownId);",
          "  if (other) pm.collectionVariables.set(\"otherStudentId\", other.id);",
          "}",
          "if (url.endsWith(\"/api/students\") && pm.request.method === \"POST\" && expected === 201)",
          "  pm.collectionVariables.set(\"studentId\", pm.response.json().id);",
          "if (url.endsWith(\"/api/courses\") && pm.request.method === \"POST\" && expected === 201)",
          "  pm.collectionVariables.set(\"courseId\", pm.response.json().id);",
          "if (url.includes(\"/enrollments\") && pm.request.method === \"POST\" && expected === 201)",
          "  pm.collectionVariables.set(\"enrollmentId\", pm.response.json().id);"
        ]
      }
    }
  ],
